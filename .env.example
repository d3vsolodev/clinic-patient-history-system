# Copy to .env and replace every placeholder before starting local services.
# Keep .env out of version control; never put production values in this file.
DB_NAME=clinic_patient_history
DB_USER=postgres
DB_PASSWORD=replace_with_a_unique_local_database_password
DB_PORT=5432

# Generate two independent, high-entropy values for non-local environments.
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

CLIENT_URL=http://localhost:5173,http://localhost:8080
AUTH_COOKIE_SECURE=false
VITE_API_URL=http://localhost:5000/api

# For Supabase, set DB_URL to a JDBC connection string and DB_SSLMODE=require.
# Use the project's direct or session-pooler host as appropriate for the app.
# DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# DB_SSLMODE=require
